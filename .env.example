# Copy this file to .env and fill in your values. .env is git-ignored.

# Kaggle API (kaggle.com > Settings > API > Create New Token). Needed from step 3.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional: store data outside the repo (e.g. a bigger drive). AMLworld Large is ~16 GB of CSV.
